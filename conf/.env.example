# ==================== 数据库 ====================

# PostgreSQL 数据库密码（认证、元数据和会话持久化共用）
APP_PG_PORT=5432
POSTGRES_PASSWORD=

# 独立的业务 PostgreSQL；如使用已有实例，请改为该实例的地址、端口及账号。
BUSINESS_PG_HOST=127.0.0.1
BUSINESS_PG_PORT=5434
BUSINESS_PG_DATABASE=ecommerce
BUSINESS_PG_SCHEMA=public
BUSINESS_PG_ADMIN_USER=dataagent_admin
# 必填。使用已有库的真实凭据，或为新建的本地业务库单独生成随机密码。
BUSINESS_PG_ADMIN_PASSWORD=

# PostgreSQL 查询身份凭据加密密钥
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BUSINESS_PG_CREDENTIAL_ENCRYPTION_KEY=

# ==================== 身份认证与管理员 ====================

# JWT 签名密钥，必须使用至少 32 字符的随机值
# uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# 初始管理员引导凭据（scripts/bootstrap_admin.py）
# 用户名和邮箱可通过 CLI 覆盖；密码从环境变量读取
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ==================== 模型服务 ====================

# DeepSeek 官方 API 密钥
DEEPSEEK_API_KEY=

# SiliconFlow 模型服务密钥
SILICONFLOW_API_KEY=

# ==================== MCP 工具 ====================

# Tavily MCP 搜索服务密钥
TAVILY_API_KEY=
