# ==================== 数据库 ====================

# PostgreSQL 数据库密码（认证、元数据和会话持久化共用）
POSTGRES_PASSWORD=

# Doris 平台内部管理账号密码，用于元数据读取和权限管理
DORIS_ADMIN_PASSWORD=

# Doris 查询身份凭据加密密钥
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DORIS_CREDENTIAL_ENCRYPTION_KEY=

# ==================== 身份认证与管理员 ====================

# JWT 签名密钥，必须使用至少 32 字符的随机值
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# 初始管理员引导凭据（scripts/bootstrap_admin.py）
# 用户名和邮箱可通过 CLI 覆盖；密码从环境变量读取
ADMIN_USERNAME=123
ADMIN_EMAIL=123@123.com
ADMIN_PASSWORD=

# ==================== 模型服务 ====================

# DeepSeek 官方 API 密钥
DEEPSEEK_API_KEY=

# OpenRouter 模型服务密钥
OPENROUTER_API_KEY=

# SiliconFlow 模型服务密钥
SILICONFLOW_API_KEY=

# ==================== MCP 工具 ====================

# Tavily MCP 搜索服务密钥
TAVILY_API_KEY=
