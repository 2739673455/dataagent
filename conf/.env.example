# Doris 数据库密码
DORIS_PASSWORD=

# Doris 权限管理账号密码，管理 Row Policy 需要受控的 ADMIN_PRIV
DORIS_SECURITY_ADMIN_PASSWORD=

# 缺省 Doris 角色的稳定共享查询账号密码
DORIS_DEFAULT_QUERY_PASSWORD=

# 扩展 Doris 角色的稳定共享查询账号密码
DORIS_PRIVILEGED_QUERY_PASSWORD=

# PostgreSQL 数据库密码
POSTGRES_PASSWORD=

# tavily 密钥
TAVILY_API_KEY=

# siliconflow 密钥
SILICONFLOW_API_KEY=

# openrouter 密钥
OPENROUTER_API_KEY=

# JWT 签名密钥，必须使用至少 32 字符的随机值
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# 管理员引导凭据，仅在执行 python -m scripts.bootstrap_admin 时设置
DATAAGENT_BOOTSTRAP_ADMIN_USERNAME=
DATAAGENT_BOOTSTRAP_ADMIN_EMAIL=
DATAAGENT_BOOTSTRAP_ADMIN_PASSWORD=
